TG_BOT_TOKEN=
# Dedicated group ID for this radar, separate from any trade group.
# Usually starts with -100.
TG_RADAR_GROUP_CHAT_ID=
TG_SIGNAL_THREAD_ID=
# Kirim board WATCH bersama SIGNAL. Set 0 jika ingin mematikan WATCH.
TG_SEND_WATCH=1
# Any comma-separated subset is allowed. Supported:
# sol,bsc,base,eth,arbitrum,hyperevm,robinhood,arc,stable
# Default keeps API usage lower: bsc,base
RADAR_CHAINS=bsc,base
RADAR_TIMEZONE=UTC
RADAR_LOCATION=UTC
