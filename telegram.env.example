TG_BOT_TOKEN=
# Dedicated group ID for this radar, separate from any trade group.
# Usually starts with -100.
TG_RADAR_GROUP_CHAT_ID=
# Topic untuk board SIGNAL; kosongkan jika ingin ke general/main channel.
TG_SIGNAL_THREAD_ID=
# Kirim board WATCH bersama SIGNAL. Set 0 jika ingin mematikan WATCH.
TG_SEND_WATCH=1
# Topic khusus board WATCH; nama utama yang digunakan script.
TG_SEND_WATCH_THREAD_ID=
# Alias pendek yang juga didukung: TG_WATCH_THREAD_ID=
# Topic khusus VOLUME SPIKE. Kosong berarti alert volume tidak dikirim.
TG_VOLUME_THREAD_ID=
# Any comma-separated subset is allowed. Supported:
# sol,bsc,base,eth,arbitrum,hyperevm,robinhood,arc,stable
# Chain yang dipakai SIGNAL dan WATCH.
RADAR_CHAINS=bsc,base
# Chain yang dipakai VOLUME SPIKE. Bisa berbeda dari RADAR_CHAINS.
VOLUME_CHAINS=bsc,base
RADAR_TIMEZONE=UTC
RADAR_LOCATION=UTC
# Scheduling volume: timer utama tetap setiap 5 menit.
RADAR_INTERVAL_SECONDS=300
VOLUME_SAFETY_SECONDS=10
# Jeda setelah SIGNAL/WATCH sebelum request volume dimulai.
VOLUME_START_DELAY_SECONDS=60
# Jumlah token yang dianalisis detail oleh SIGNAL per chain.
SIGNAL_ANALYSIS_LIMIT=10
# Maksimal kandidat per chain yang diputar untuk scan volume.
VOLUME_SCAN_LIMIT=20
# Threshold volume spike; sesuaikan setelah melihat satuan raw GMGN.
VOLUME_SPIKE_MIN_15M=500000
VOLUME_SPIKE_MIN_1H=1000000
# Hindari alert token yang sama berulang terlalu cepat.
VOLUME_ALERT_COOLDOWN_SECONDS=900
